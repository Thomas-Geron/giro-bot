# URL do Giro (sem barra no final)
GIRO_URL=https://revendedora-web.onrender.com

# Token do bot desta loja (gerado no Giro, em Bot > "Gerar token")
GIRO_BOT_TOKEN=cole-o-token-aqui

# Canais ativos, separados por vírgula: whatsapp, olx, simulado
CANAIS=simulado

# Intervalo entre as varreduras, em segundos
POLL_SEGUNDOS=15

# Pasta do perfil do navegador (mantém o login salvo entre execuções)
PERFIL_DIR=perfil

# Deixe false: o WhatsApp Web exige janela visível para ler o QR na 1a vez
HEADLESS=false
